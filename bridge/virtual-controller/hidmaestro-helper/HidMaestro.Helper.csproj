<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <HidMaestroSdkRoot Condition="'$(HidMaestroSdkRoot)' == ''">$(HIDMAESTRO_SDK_ROOT)</HidMaestroSdkRoot>
    <HidMaestroSdkRoot Condition="'$(HidMaestroSdkRoot)' == ''">$(UserProfile)\Downloads\HIDMaestro-v1.9.0\HIDMaestroTest</HidMaestroSdkRoot>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="HIDMaestro.Core">
      <HintPath>$(HidMaestroSdkRoot)\HIDMaestro.Core.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <Target Name="ValidateHidMaestroSdk" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(HidMaestroSdkRoot)\HIDMaestro.Core.dll')"
           Text="HIDMaestro.Core.dll was not found. Set HIDMAESTRO_SDK_ROOT to the verified HIDMaestro v1.9.0 SDK directory." />
  </Target>
</Project>
